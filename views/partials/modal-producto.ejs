<div id="modalProducto" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-lg transform transition-all">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800">Nuevo Producto</h2>
            <button onclick="document.getElementById('modalProducto').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <form id="formProducto" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Producto</label>
                    <input type="text" id="prodName" name="name" maxlength="50" required class="w-full border rounded-lg p-2 focus:ring-blue-500 border-gray-300 shadow-sm" placeholder="Ej: Monitor Gamer 24'">
                </div>

                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
                    <select id="selectCategorias" name="categoryId" required class="w-full border rounded-lg p-2 focus:ring-blue-500 border-gray-300 shadow-sm bg-white">
                        <option value="">Cargando categorías...</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">SKU (Código único)</label>
                    <input type="text" id="prodSku" name="sku" required class="w-full border rounded-lg p-2 focus:ring-blue-500 border-gray-300 shadow-sm" placeholder="MOD-001">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Precio Unitario</label>
                    <input type="number" name="price" step="0.01" min="0" required class="w-full border rounded-lg p-2 focus:ring-blue-500 border-gray-300 shadow-sm" placeholder="0.00">
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Stock Inicial</label>
                    <input type="number" id="prodStock" name="stock" min="0" required class="w-full border rounded-lg p-2 focus:ring-blue-500 border-gray-300 shadow-sm" placeholder="Cantidad actual">
                </div>
            </div>

            <p id="errorProducto" class="hidden text-sm text-red-600" role="alert"></p>

            <div class="pt-4 flex gap-3">
                <button type="button" onclick="cerrarModalProducto()" class="flex-1 py-2 border rounded-lg text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar
                </button>
                <button id="btnGuardarProducto" type="submit" class="flex-1 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-bold transition-all shadow-lg">
                    Guardar en Inventario
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    async function fetchCategories() {
        const select = document.getElementById('selectCategorias')
        try {
            const response = await fetch('/api/categories')
            if (!response.ok) throw new Error('No se pudieron cargar las categorías')

            const categories = await response.json()

            select.replaceChildren(new Option('Seleccione una categoría', ''))
            categories.forEach(category => {
                select.add(new Option(category.name, category.id))
            })
            return true
        } catch (error) {
            select.innerHTML = '<option value="">Error al cargar categorías</option>'
            console.error(error)
            return false
        }
    }

    function abrirModalEdicion(producto) {
        const modal = document.getElementById('modalProducto')
        const form = document.getElementById('formProducto')

        modal.querySelector('h2').textContent = 'Editar Producto'
        document.getElementById('btnGuardarProducto').textContent = 'Actualizar Producto'
        document.getElementById('errorProducto').classList.add('hidden')
        form.querySelector('[name="name"]').value = producto.name
        form.querySelector('[name="sku"]').value = producto.sku
        form.querySelector('[name="price"]').value = producto.price
        form.querySelector('[name="stock"]').value = producto.stock
        form.querySelector('[name="categoryId"]').value = producto.categoryId
        form.dataset.editId = producto.id
        modal.classList.remove('hidden')
    }

    function cerrarModalProducto() {
        document.getElementById('modalProducto').classList.add('hidden')
    }

    document.getElementById('formProducto').addEventListener('submit', async (event) => {
        event.preventDefault()

        const form = event.currentTarget
        const editId = form.dataset.editId
        const errorElement = document.getElementById('errorProducto')
        const submitButton = document.getElementById('btnGuardarProducto')
        const data = Object.fromEntries(new FormData(form))

        errorElement.classList.add('hidden')
        submitButton.disabled = true

        try {
            const response = await fetch(
                editId
                    ? `/api/products/${encodeURIComponent(editId)}`
                    : '/api/products',
                {
                    method: editId ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }
            )

            if (!response.ok) {
                const result = await response.json()
                throw new Error(result.error || result.message || 'No se pudo guardar el producto')

        modal.querySelector('h2').textContent = 'Editar Producto'
        form.querySelector('button[type="submit"]').textContent = 'Actualizar Producto'

        form.elements.name.value = producto.name
        form.elements.sku.value = producto.sku
        form.elements.price.value = producto.price
        form.elements.stock.value = producto.stock
        form.elements.categoryId.value = producto.categoryId

        form.dataset.editId = producto.id
        modal.classList.remove('hidden')
    }

    document.getElementById('formProducto').addEventListener('submit', async (event) => {
        event.preventDefault()

        const form = event.currentTarget
        const editId = form.dataset.editId
        const data = Object.fromEntries(new FormData(form))
        const submitButton = form.querySelector('button[type="submit"]')
        submitButton.disabled = true

        try {
            const response = await fetch(
                editId
                    ? `/api/products/${encodeURIComponent(editId)}`
                    : '/api/products',
                {
                    method: editId ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }
            )

            if (!response.ok) {
                const error = await response.json()
                throw new Error(error.error || error.message || 'No se pudo guardar el producto')
            }

            location.reload()
        } catch (error) {
            errorElement.textContent = error.message || 'No se pudo conectar con el servidor'
            errorElement.classList.remove('hidden')

            console.error('Error al guardar producto:', error)
            alert(error.message || 'No se pudo conectar con el servidor')

        } finally {
            submitButton.disabled = false
        }
    })
</script>