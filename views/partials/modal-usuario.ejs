<div
    id="modalUsuario"
    class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tituloUsuario"
    onclick="if (event.target === this) cerrarModalUsuario()">
    <div class="bg-white p-8 rounded-xl shadow-2xl w-full max-w-md">
        <div class="flex justify-between items-center mb-6">
            <h2 id="tituloUsuario" class="text-xl font-bold text-gray-800">Nuevo Usuario</h2>
            <button
                type="button"
                aria-label="Cerrar"
                onclick="cerrarModalUsuario()"
                class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="userForm" class="space-y-4">
            <div>
                <label for="usernameUsuario" class="block text-sm font-medium text-gray-700 mb-1">Correo</label>
                <input
                    id="usernameUsuario"
                    type="email"
                    name="username"
                    autocomplete="email"
                    required
                    placeholder="correo@empresa.com"
                    class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
                <label for="passwordUsuario" class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
                <input
                    id="passwordUsuario"
                    type="password"
                    name="password"
                    autocomplete="new-password"
                    minlength="8"
                    required
                    placeholder="Mínimo 8 caracteres, un número y una mayúscula"
                    class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
                <label for="roleUsuario" class="block text-sm font-medium text-gray-700 mb-1">Rol</label>
                <select
                    id="roleUsuario"
                    name="role"
                    class="w-full border border-gray-300 rounded-lg p-2 focus:ring-2 focus:ring-indigo-500">
                    <option value="viewer">Viewer</option>
                    <option value="manager">Manager</option>
                </select>
            </div>

            <p id="errorUsuario" class="hidden text-sm text-red-600" role="alert"></p>

            <div class="flex gap-3 pt-2">
                <button
                    type="button"
                    onclick="cerrarModalUsuario()"
                    class="flex-1 py-2 border rounded-lg text-gray-600 hover:bg-gray-50 transition-colors">
                    Cancelar
                </button>
                <button
                    id="btnGuardarUsuario"
                    type="submit"
                    class="flex-1 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-bold transition-all">
                    Crear Usuario
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function abrirModalUsuario() {
    const modal = document.getElementById('modalUsuario')
    const form = document.getElementById('userForm')

    form.reset()
    document.getElementById('errorUsuario').classList.add('hidden')
    modal.classList.remove('hidden')
    document.getElementById('usernameUsuario').focus()
}

function cerrarModalUsuario() {
    document.getElementById('modalUsuario').classList.add('hidden')
}

document.getElementById('userForm').addEventListener('submit', async (event) => {
    event.preventDefault()

    const form = event.currentTarget
    const errorElement = document.getElementById('errorUsuario')
    const submitButton = document.getElementById('btnGuardarUsuario')
    const data = Object.fromEntries(new FormData(form))

    errorElement.classList.add('hidden')
    submitButton.disabled = true

    try {
        const response = await fetch('/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })

        if (!response.ok) {
            const message = await response.text()
            throw new Error(message || 'No se pudo crear el usuario')
        }

        cerrarModalUsuario()
        await loadUsers()
    } catch (error) {
        errorElement.textContent = error.message || 'No se pudo conectar con el servidor'
        errorElement.classList.remove('hidden')
    } finally {
        submitButton.disabled = false
    }
})

document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') cerrarModalUsuario()
})
</script>
