<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <title>NodeStock - Nueva contraseña</title>
  <script>
    (() => {
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
    })();
  </script>
  <style>
    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f3f4f6;
      color: #1f2937;
      font-family: ui-sans-serif, system-ui, sans-serif;
    }
    .page { width: 100%; max-width: 384px; }
    .brand { margin-bottom: 32px; text-align: center; }
    .brand h1 { margin: 0; font-size: 30px; }
    .brand p, .description { color: #6b7280; }
    .brand p { margin: 4px 0 0; }
    .card {
      overflow: hidden;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      background: white;
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 10%);
    }
    .card-title {
      padding: 16px;
      border-bottom: 1px solid #f3f4f6;
      background: #f9fafb;
      color: #4f46e5;
      text-align: center;
      font-weight: 700;
    }
    form { padding: 32px; }
    h2 { margin: 0 0 12px; text-align: center; font-size: 24px; }
    .description { margin: 0 0 24px; text-align: center; font-size: 14px; }
    label { display: block; margin-bottom: 4px; color: #4b5563; font-size: 14px; font-weight: 600; }
    .field { margin-bottom: 16px; }
    .field.last { margin-bottom: 24px; }
    input[type="password"] {
      width: 100%;
      padding: 10px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 16px;
    }
    input[type="password"]:focus { outline: 2px solid #6366f1; }
    button {
      width: 100%;
      padding: 12px;
      border: 0;
      border-radius: 8px;
      background: #4f46e5;
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }
    button:hover { background: #4338ca; }
    .message { min-height: 24px; margin: 16px 0 0; text-align: center; font-size: 14px; }
    .back { display: block; margin-top: 8px; color: #4f46e5; text-align: center; font-size: 14px; font-weight: 600; }
  </style>
</head>
<body>
  <div class="page">
    <div class="brand">
      <div class="flex justify-end mb-4">
        <button type="button" data-theme-toggle class="theme-toggle-btn px-3 py-2 rounded-lg border transition-all shadow-sm text-lg leading-none" aria-label="Cambiar tema">
          🌙
        </button>
      </div>
      <h1>📦 NodeStock</h1>
      <p>Gestión de Inventario Profesional</p>
    </div>

    <div class="card">
      <div class="card-title">
        Nueva contraseña
      </div>

      <form id="reset-form">
        <h2>Crea una nueva contraseña</h2>
        <p class="description">
          Debe tener al menos 8 caracteres, una mayúscula y un número.
        </p>

        <input type="hidden" name="token" value="<%= token %>">

        <div class="field">
          <label for="new-password">Nueva contraseña</label>
          <input type="password" id="new-password" name="newPassword" minlength="8" required autocomplete="new-password">
        </div>

        <div class="field last">
          <label for="confirm-password">Confirmar nueva contraseña</label>
          <input type="password" id="confirm-password" name="confirmPassword" minlength="8" required autocomplete="new-password">
        </div>

        <button type="submit">Guardar contraseña</button>
        <p id="form-message" role="status" aria-live="polite" class="message"></p>
        <a href="/" class="back">Volver al inicio de sesión</a>
      </form>
    </div>
  </div>

  <script>
    const form = document.querySelector('#reset-form')
    const message = document.querySelector('#form-message')

    form.addEventListener('submit', async event => {
      event.preventDefault()

      const { token, newPassword, confirmPassword } = Object.fromEntries(new FormData(form))

      if (newPassword !== confirmPassword) {
        message.textContent = 'Las contraseñas no coinciden.'
        message.style.color = '#dc2626'
        return
      }

      try {
        const response = await fetch('/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, newPassword })
        })

        if (!response.ok) {
          message.textContent = await response.text()
          message.style.color = '#dc2626'
          return
        }

        message.textContent = 'Contraseña actualizada. Ya puedes iniciar sesión.'
        message.style.color = '#16a34a'
        form.reset()
      } catch (error) {
        message.textContent = 'No se pudo restablecer la contraseña. Inténtalo de nuevo.'
        message.style.color = '#dc2626'
      }
    })
  </script>
  <link rel="stylesheet" href="/styles.css">
  <script src="/theme.js" defer></script>
</body>
</html>
