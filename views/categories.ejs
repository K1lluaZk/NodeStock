<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Categorías - NodeStock</title>

    <script>
        (() => {
            const storedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
        })();
    </script>

    <%- include('partials/favicon') %>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css">
    <script src="/theme.js" defer></script>
</head>

<body class="bg-gray-100 p-8">

<div class="max-w-4xl mx-auto">

    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">📁 Categorías</h1>
        <div class="flex items-center gap-4">
            <button type="button" data-theme-toggle class="theme-toggle-btn px-3 py-2 rounded-lg border transition-all shadow-sm text-lg leading-none" aria-label="Cambiar tema">
                🌙
            </button>
            <% if (user.role === 'admin' || user.role === 'manager') { %>
                <button
                    type="button"
                    onclick="abrirModalNuevaCategoria()"
                    class="bg-indigo-600 text-white px-5 py-2 rounded-lg font-bold hover:bg-indigo-700 transition-all">
                    Nueva Categoría
                </button>
            <% } %>
            <a
                href="/dashboard"
                class="bg-red-600 text-white px-5 py-2 rounded-lg font-bold hover:bg-red-700 transition-all">
                ← Volver al Inventario
            </a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200">
        <table class="w-full text-left">

            <thead class="bg-gray-50 border-b">
                <tr class="text-gray-600 text-sm uppercase">
                    <th class="p-4 font-semibold">Nombre</th>
                    <th class="p-4 font-semibold">Descripción</th>
                    <% if (user.role === 'admin' || user.role === 'manager') { %>
                        <th class="p-4 text-right font-semibold">Acciones</th>
                    <% } %>
                </tr>
            </thead>

            <tbody id="lista-categorias" class="divide-y divide-gray-100">
            </tbody>

        </table>
    </div>

</div>

<% if (user.role === 'admin' || user.role === 'manager') { %>
    <%- include('partials/modal-categoria') %>
<% } %>

<script>
async function loadCats() {
    const body = document.getElementById('lista-categorias')

    try {
        const res = await fetch('/api/categories')
        if (!res.ok) throw new Error('No se pudieron cargar las categorías')

        const categories = await res.json()
        body.innerHTML = categories.map(cat => `
            <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-4 font-bold text-gray-800">${escapeHtml(cat.name)}</td>
                <td class="p-4 text-gray-500">${escapeHtml(cat.description || '-')}</td>
                <% if (user.role === 'admin' || user.role === 'manager') { %>
                    <td class="p-4 text-right">
                        <button
                            type="button"
                            data-action="edit"
                            data-id="${escapeHtml(cat.id)}"
                            data-name="${escapeHtml(cat.name)}"
                            data-description="${escapeHtml(cat.description || '')}"
                            class="text-blue-500 hover:text-blue-700 font-medium mr-3">
                            ✏️ Editar
                        </button>
                        <button
                            type="button"
                            data-action="delete"
                            data-id="${escapeHtml(cat.id)}"
                            class="text-red-500 hover:text-red-700 font-medium">
                            🗑️ Eliminar
                        </button>
                    </td>
                <% } %>
            </tr>
        `).join('')
    } catch (error) {
        body.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-red-600">No se pudieron cargar las categorías.</td></tr>'
        console.error(error)
    }
}

function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    })[character])
}

document.getElementById('lista-categorias').addEventListener('click', async (event) => {
    const button = event.target.closest('button[data-action]')
    if (!button) return

    if (button.dataset.action === 'edit') {
        abrirModalEditarCategoria({
            id: button.dataset.id,
            name: button.dataset.name,
            description: button.dataset.description
        })
    } else if (button.dataset.action === 'delete') {
        await eliminarCategoria(button.dataset.id)
    }
})

async function eliminarCategoria(id) {
    if (!confirm('¿Estás seguro de eliminar esta categoría?')) return

    try {
        const res = await fetch(`/api/categories/${encodeURIComponent(id)}`, {
            method: 'DELETE'
        })

        if (!res.ok) {
            const error = await res.json()
            throw new Error(error.error || error.message || 'Error al eliminar la categoría')
        }

        await loadCats()
    } catch (error) {
        alert(error.message || 'No se pudo conectar con el servidor')
    }
}

loadCats()
</script>
</body>
</html>
