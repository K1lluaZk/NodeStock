<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NodeStock - Recuperar contraseña</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex justify-center items-center min-h-screen m-0 p-4">
  <div class="flex flex-col items-center w-full">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-800">📦 NodeStock</h1>
      <p class="text-gray-500">Gestión de Inventario Profesional</p>
    </div>

    <div class="bg-white rounded-xl shadow-lg border border-gray-200 w-full max-w-sm overflow-hidden">
      <div class="border-b border-gray-100 bg-gray-50/50 py-4 text-center font-bold text-indigo-600">
        Recuperar contraseña
      </div>

      <div class="p-8">
        <form id="recovery-form">
          <h2 class="text-2xl font-bold text-gray-800 mb-3 text-center">¿Olvidaste tu contraseña?</h2>
          <p class="text-sm text-gray-600 mb-6 text-center">
            Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.
          </p>

          <div class="mb-6">
            <label for="username" class="block mb-1 text-sm font-semibold text-gray-600">Correo electrónico</label>
            <input type="email" id="username" name="username" placeholder="correo@empresa.com" required
              class="w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition-all shadow-sm">
          </div>

          <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-bold shadow-md transition-all">
            Enviar enlace
          </button>
          <p id="form-message" role="status" aria-live="polite" class="mt-4 text-center min-h-[1.5em] text-sm font-medium"></p>
          <a href="/" class="block mt-2 text-center text-sm font-semibold text-indigo-600 hover:text-indigo-800">
            Volver al inicio de sesión
          </a>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.querySelector('#recovery-form')
    const message = document.querySelector('#form-message')

    form.addEventListener('submit', async event => {
      event.preventDefault()
      const button = form.querySelector('button[type="submit"]')
      button.disabled = true
      button.textContent = 'Enviando...'

      try {
        const response = await fetch('/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: form.elements.username.value })
        })

        if (!response.ok) {
          message.textContent = await response.text()
          message.className = 'mt-4 text-center min-h-[1.5em] text-sm font-medium text-red-600'
          return
        }

        const result = await response.json()
        message.textContent = result.message
        message.className = 'mt-4 text-center min-h-[1.5em] text-sm font-medium text-green-600'
        form.reset()
      } catch (error) {
        message.textContent = 'No se pudo procesar la solicitud. Inténtalo de nuevo.'
        message.className = 'mt-4 text-center min-h-[1.5em] text-sm font-medium text-red-600'
      } finally {
        button.disabled = false
        button.textContent = 'Enviar enlace'
      }
    })
  </script>
</body>
</html>
